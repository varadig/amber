	"patterns": [
		{
			"match": "^SCORE ([0-9]+)   LEVEL ([0-9]+)$",
			"out": "PONT $1   PÁLYA $2"
		},
		{
			"match": "^LV ([0-9]+)$",
			"out": "$1. P."
		},
		{
			"match": "^([0-9]+) AT$",
			"out": "$1 ATOM"
		},
		{
			"match": "^PLATES DOWN: ([0-9]+) / ([0-9]+)$",
			"out": "LENYOMOTT LAPOK: $1 / $2"
		},
		{
			"match": "^LIVES (.*)$",
			"out": "ÉLET $1"
		},
		{
			"match": "^ATOMS (\\d+)/(\\d+)  BANK (\\d+)$",
			"out": "ATOM $1/$2  BANK $3"
		},
		{
			"match": "^ATOMS (\\d+)/(\\d+)  ALL FOUND \\+500$",
			"out": "ATOM $1/$2  MIND MEGVAN +500"
		},
		{
			"match": "^ATOMS (\\d+)/(\\d+)$",
			"out": "ATOM $1/$2"
		},
		{
			"match": "^ATOMS (\\d+)$",
			"out": "ATOM $1"
		},
		{
			"match": "^ATOM BANK (\\d+)  \\(WORKSHOP READY\\)$",
			"out": "ATOMBANK $1  (A MŰHELY NYITVA)"
		},
		{
			"match": "^ATOM BANK (\\d+)$",
			"out": "ATOMBANK $1"
		},
		{
			"match": "^SCORE (\\d+)$",
			"out": "PONT $1"
		},
		{
			"match": "^FINAL SCORE (\\d+)$",
			"out": "VÉGSŐ PONTSZÁM $1"
		},
		{
			"match": "^TIME (.+)$",
			"out": "IDŐ $1"
		},
		{
			"match": "^PARTS (\\d+)/(\\d+)$",
			"out": "ALKATRÉSZ $1/$2"
		},
		{
			"match": "^PARTS (.+)$",
			"out": "ALKATRÉSZEK: {names:1}"
		},
		{
			"match": "^JET (.*)$",
			"out": "REPÜLÉS $1"
		},
		{
			"match": "^NEXT (.+) (>>|<<|\\^\\^|vv) (\\d+)M$",
			"out": "KÖVETKEZŐ: {names:1} $2 $3M"
		},
		{
			"match": "^(< |\\^ |v )(.+) (\\d+)M$",
			"out": "$1{names:2} $3M"
		},
		{
			"match": "^(.+) (\\d+)M >$",
			"out": "{names:1} $2M >"
		},
		{
			"match": "^NEED (\\d+) MORE PARTS? FOR (.+)$",
			"out": "{names:2}: MÉG $1 ALKATRÉSZ KELL"
		},
		{
			"match": "^NEED (\\d+) MORE PARTS?$",
			"out": "MÉG $1 ALKATRÉSZ KELL"
		},
		{
			"match": "^CONTROL: (.+)$",
			"out": "IRÁNYÍTOTT: {names:1}"
		},
		{
			"match": "^TAB: SWITCH  Q: FOLLOW$",
			"out": "TAB: VÁLTÁS  Q: KÖVETNEK"
		},
		{
			"match": "^TAB: SWITCH  Q: WAIT$",
			"out": "TAB: VÁLTÁS  Q: VÁRNAK"
		},
		{
			"match": "^FRIEND BUILT: (.+)$",
			"out": "TÁRS MEGÉPÍTVE: $1"
		},
		{
			"match": "^SECRET ATOM \\+(\\d+)$",
			"out": "TITKOS ATOM +$1"
		},
		{
			"match": "^A PART FOR YOUR FRIEND (.+)$",
			"out": "ALKATRÉSZ A TÁRSADNAK: $1"
		},
		{
			"match": "^FOUND: (.+)$",
			"out": "MEGVAN: {names:1}"
		},
		{
			"match": "^UPGRADED: (.+)$",
			"out": "FEJLESZTVE: {text:1}"
		},
		{
			"match": "^BACKUPS LEFT: (\\d+)$",
			"out": "MARADÉK MENTÉS: $1"
		},
		{
			"match": "^LEVEL (\\d+): (.+)$",
			"out": "$1. PÁLYA: {names:2}"
		},
		{
			"match": "^LEVEL (\\d+) CLEAR$",
			"out": "$1. PÁLYA TELJESÍTVE"
		},
		{
			"match": "^FIND (\\d+) PARTS: (.+)$",
			"out": "KERESS $1 ALKATRÉSZT: {names:2}"
		},
		{
			"match": "^FRIEND PARTS: (.+)$",
			"out": "TÁRS-ALKATRÉSZEK: {names:1}"
		},
		{
			"match": "^ORDER: (.+)$",
			"out": "SORREND: $1"
		},
		{
			"match": "^ENEMIES (\\d+)   ONE HIT AND YOU RESTART$",
			"out": "ELLENSÉG: $1   EGY TALÁLAT ÉS ÚJRAKEZDED"
		},
		{
			"match": "^YOUR TURN  (\\d+)/(\\d+)$",
			"out": "TE JÖSSZ  $1/$2"
		},
		{
			"match": "^(.+?) ([IV]+)>([IV]+) \\[(\\d+)\\] (.+)$",
			"out": "{names:1} $2>$3 [$4] {text:5}"
		},
		{
			"match": "^(.+?)  ([IV]+)  \\(MAX\\)$",
			"out": "{names:1}  $2  (MAX)"
		},
		{
			"match": "^MUSIC(\\s+)(.*)$",
			"out": "ZENE$1$2"
		},
		{
			"match": "^SFX(\\s+)(.*)$",
			"out": "EFFEKT$1$2"
		},
		{
			"match": "^VIBRATION(\\s+)ON$",
			"out": "REZGÉS$1BE"
		},
		{
			"match": "^VIBRATION(\\s+)OFF$",
			"out": "REZGÉS$1KI"
		},
		{
			"match": "^DEVICE HINTS(\\s+)ON$",
			"out": "ESZKÖZ-SÚGÓ$1BE"
		},
		{
			"match": "^DEVICE HINTS(\\s+)OFF$",
			"out": "ESZKÖZ-SÚGÓ$1KI"
		},
		{
			"match": "^FULLSCREEN(\\s+)ON$",
			"out": "TELJES KÉPERNYŐ$1BE"
		},
		{
			"match": "^FULLSCREEN(\\s+)OFF$",
			"out": "TELJES KÉPERNYŐ$1KI"
		},
		{
			"match": "^LANGUAGE(\\s+)(.+)$",
			"out": "NYELV$1$2"
		}
	],
