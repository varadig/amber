	"patterns": [
		{
			"match": "^SCORE ([0-9]+)   LEVEL ([0-9]+)$",
			"out": "SCORE $1   LEVEL $2"
		},
		{
			"match": "^LV ([0-9]+)$",
			"out": "LV $1"
		},
		{
			"match": "^([0-9]+) AT$",
			"out": "$1 AT"
		},
		{
			"match": "^PLATES DOWN: ([0-9]+) / ([0-9]+)$",
			"out": "PLATES DOWN: $1 / $2"
		},
		{
			"match": "^LIVES (.*)$",
			"out": "LIVES $1"
		},
		{
			"match": "^ATOMS (\\d+)/(\\d+)  BANK (\\d+)$",
			"out": "ATOMS $1/$2  BANK $3"
		},
		{
			"match": "^ATOMS (\\d+)/(\\d+)  ALL FOUND \\+500$",
			"out": "ATOMS $1/$2  ALL FOUND +500"
		},
		{
			"match": "^ATOMS (\\d+)/(\\d+)$",
			"out": "ATOMS $1/$2"
		},
		{
			"match": "^ATOMS (\\d+)$",
			"out": "ATOMS $1"
		},
		{
			"match": "^ATOM BANK (\\d+)  \\(WORKSHOP READY\\)$",
			"out": "ATOM BANK $1  (WORKSHOP READY)"
		},
		{
			"match": "^ATOM BANK (\\d+)$",
			"out": "ATOM BANK $1"
		},
		{
			"match": "^SCORE (\\d+)$",
			"out": "SCORE $1"
		},
		{
			"match": "^FINAL SCORE (\\d+)$",
			"out": "FINAL SCORE $1"
		},
		{
			"match": "^TIME (.+)$",
			"out": "TIME $1"
		},
		{
			"match": "^PARTS (\\d+)/(\\d+)$",
			"out": "PARTS $1/$2"
		},
		{
			"match": "^PARTS (.+)$",
			"out": "PARTS {names:1}"
		},
		{
			"match": "^JET (.*)$",
			"out": "JET $1"
		},
		{
			"match": "^NEXT (.+) (>>|<<|\\^\\^|vv) (\\d+)M$",
			"out": "NEXT {names:1} $2 $3M"
		},
		{
			"match": "^(< |\\^ |v )(.+) (\\d+)M$",
			"out": "$1{names:2} $3M"
		},
		{
			"match": "^(.+) (\\d+)M >$",
			"out": "{names:1} $2M >"
		},
		{
			"match": "^NEED (\\d+) MORE PARTS? FOR (.+)$",
			"out": "NEED $1 MORE PARTS FOR {names:2}"
		},
		{
			"match": "^NEED (\\d+) MORE PARTS?$",
			"out": "NEED $1 MORE PARTS"
		},
		{
			"match": "^CONTROL: (.+)$",
			"out": "CONTROL: {names:1}"
		},
		{
			"match": "^TAB: SWITCH  Q: FOLLOW$",
			"out": "TAB: SWITCH  Q: FOLLOW"
		},
		{
			"match": "^TAB: SWITCH  Q: WAIT$",
			"out": "TAB: SWITCH  Q: WAIT"
		},
		{
			"match": "^FRIEND BUILT: (.+)$",
			"out": "FRIEND BUILT: $1"
		},
		{
			"match": "^SECRET ATOM \\+(\\d+)$",
			"out": "SECRET ATOM +$1"
		},
		{
			"match": "^A PART FOR YOUR FRIEND (.+)$",
			"out": "A PART FOR YOUR FRIEND $1"
		},
		{
			"match": "^FOUND: (.+)$",
			"out": "FOUND: {names:1}"
		},
		{
			"match": "^UPGRADED: (.+)$",
			"out": "UPGRADED: {text:1}"
		},
		{
			"match": "^BACKUPS LEFT: (\\d+)$",
			"out": "BACKUPS LEFT: $1"
		},
		{
			"match": "^LEVEL (\\d+): (.+)$",
			"out": "LEVEL $1: {names:2}"
		},
		{
			"match": "^LEVEL (\\d+) CLEAR$",
			"out": "LEVEL $1 CLEAR"
		},
		{
			"match": "^FIND (\\d+) PARTS: (.+)$",
			"out": "FIND $1 PARTS: {names:2}"
		},
		{
			"match": "^FRIEND PARTS: (.+)$",
			"out": "FRIEND PARTS: {names:1}"
		},
		{
			"match": "^ORDER: (.+)$",
			"out": "ORDER: $1"
		},
		{
			"match": "^ENEMIES (\\d+)   ONE HIT AND YOU RESTART$",
			"out": "ENEMIES $1   ONE HIT AND YOU RESTART"
		},
		{
			"match": "^YOUR TURN  (\\d+)/(\\d+)$",
			"out": "YOUR TURN  $1/$2"
		},
		{
			"match": "^(.+?) ([IV]+)>([IV]+) \\[(\\d+)\\] (.+)$",
			"out": "{names:1} $2>$3 [$4] {text:5}"
		},
		{
			"match": "^(.+?)  ([IV]+)  \\(MAX\\)$",
			"out": "{names:1}  $2  (MAX)"
		},
		{
			"match": "^MUSIC(\\s+)(.*)$",
			"out": "MUSIC$1$2"
		},
		{
			"match": "^SFX(\\s+)(.*)$",
			"out": "SFX$1$2"
		},
		{
			"match": "^VIBRATION(\\s+)ON$",
			"out": "VIBRATION$1ON"
		},
		{
			"match": "^VIBRATION(\\s+)OFF$",
			"out": "VIBRATION$1OFF"
		},
		{
			"match": "^DEVICE HINTS(\\s+)ON$",
			"out": "DEVICE HINTS$1ON"
		},
		{
			"match": "^DEVICE HINTS(\\s+)OFF$",
			"out": "DEVICE HINTS$1OFF"
		},
		{
			"match": "^FULLSCREEN(\\s+)ON$",
			"out": "FULLSCREEN$1ON"
		},
		{
			"match": "^FULLSCREEN(\\s+)OFF$",
			"out": "FULLSCREEN$1OFF"
		},
		{
			"match": "^LANGUAGE(\\s+)(.+)$",
			"out": "LANGUAGE$1$2"
		}
	],
